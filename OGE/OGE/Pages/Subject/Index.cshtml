@page
@model OGE.Pages.Subject.IndexModel

<h2>Список предметов</h2>

<p>
    <a asp-page="Create" class="btn btn-primary">Добавить новый предмет</a>
</p>

<div class="row">
    @foreach (var item in Model.Subjects)
    {
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">@item.Name</h5>
                    <p class="card-text">
                        <strong>Школьник:</strong> @(item.Schoolchildren?.Name ?? "Не выбран")<br />
                        <strong>Оценка за ОГЭ:</strong> @item.Assessmentfortheoge<br />
                        <strong>Оценка за уч. год:</strong> @item.Academicyearassessment<br />
                        <strong>Итоговая оценка:</strong> @item.Finalassessment
                    </p>
                    <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Редактировать</a>
                    <a asp-page="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Удалить</a>
                </div>
            </div>
        </div>
    }
</div>