@page
@model OGE.Pages.Subject.DeleteModel

<h2>Удаление предмета</h2>

<h3>Вы уверены, что хотите удалить запись?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Subject.Name)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Subject.Name)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Subject.Assessmentfortheoge)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Subject.Assessmentfortheoge)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Subject.Academicyearassessment)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Subject.Academicyearassessment)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Subject.Finalassessment)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Subject.Finalassessment)</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Subject.Id" />
        <input type="submit" value="Удалить" class="btn btn-danger" />
        <a asp-page="Index" class="btn btn-secondary">Отмена</a>
    </form>
</div>
