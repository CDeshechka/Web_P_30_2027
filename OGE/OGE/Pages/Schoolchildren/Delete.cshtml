@page
@model OGE.Pages.Schoolchildren.DeleteModel

<h2>Удаление школьника</h2>

<h3>Вы уверены, что хотите удалить запись?</h3>
<div>
    <dl>
        <dt>@Html.DisplayNameFor(model => model.Schoolchild.Firstname)</dt>
        <dd>@Html.DisplayFor(model => model.Schoolchild.Firstname)</dd>
        <dt>@Html.DisplayNameFor(model => model.Schoolchild.Lastname)</dt>
