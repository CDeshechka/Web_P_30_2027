@page
@model OGE.Pages.Schoolchildren.EditModel

<h2>Редактирование школьника</h2>

<form method="post">
    <input type="hidden" asp-for="Schoolchild.Id" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="Schoolchild.Name" class="control-label"></label>
        <input asp-for="Schoolchild.Name" class="form-control" />
        <span asp-validation-for="Schoolchild.Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Schoolchild.Firstname" class="control-label"></label>
        <input asp-for="Schoolchild.Firstname" class="form-control" />
        <span asp-validation-for="Schoolchild.Firstname" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Schoolchild.Lastname" class="control-label"></label>
        <input asp-for="Schoolchild.Lastname" class="form-control" />
        <span asp-validation-for="Schoolchild.Lastname" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Schoolchild.Age" class="control-label"></label>
        <input asp-for="Schoolchild.Age" class="form-control" />
        <span asp-validation-for="Schoolchild.Age" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Schoolchild.Email" class="control-label"></label>
        <input asp-for="Schoolchild.Email" class="form-control" />
        <span asp-validation-for="Schoolchild.Email" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Schoolchild.Dateofbirthday" class="control-label"></label>
        <input asp-for="Schoolchild.Dateofbirthday" class="form-control" type="date" />
        <span asp-validation-for="Schoolchild.Dateofbirthday" class="text-danger"></span>
    </div>

    <div class="form-group">
        <input type="submit" value="Сохранить" class="btn btn-primary" />
        <a asp-page="Index" class="btn btn-secondary">Отмена</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}