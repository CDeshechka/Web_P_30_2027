@page
@model OGE.Pages.Auditorium.IndexModel

<h2>Список аудиторий</h2>

<p>
    <a asp-page="Create">Добавить новую аудиторию</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Название</th>
            <th>Номер аудитории</th>
            <th>Вместимость</th>
            <th>Предмет (код)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Auditoriums)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Auditoriumnumber</td>
                <td>@item.Auditoriumcapacity</td>
                <td>@item.Auditoriumsubject</td>
                <td>
                    <a asp-page="Edit" asp-route-id="@item.Id">Редактировать</a> |
                    <a asp-page="Delete" asp-route-id="@item.Id">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>
