@page
@model LoginModel
@{
    ViewData["Title"] = "Вход";
    Layout = "_Layout";
}

<h2>@ViewData["Title"]</h2>

<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="Input.Email">Email</label>
        <input asp-for="Input.Email" class="form-control" autocomplete="off" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Input.Password">Пароль</label>
        <input asp-for="Input.Password" class="form-control" autocomplete="off" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>
    <div class="form-group mt-3">
        <button type="submit" class="btn btn-primary">Войти</button>
    </div>
</form>

<p class="mt-3">
    Нет аккаунта? <a asp-page="./Register">Зарегистрироваться</a>
</p>