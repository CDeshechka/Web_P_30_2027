@page
@model OGE.Pages.Auditorium.IndexModel

<h2>Список аудиторий</h2>

<p>
    <a asp-page="Create" class="btn btn-primary">Добавить новую аудиторию</a>
</p>

<div class="row">
    @foreach (var item in Model.Auditoriums)
    {
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">@item.Name</h5>
                    <p class="card-text">
                        <strong>Номер аудитории:</strong> @item.Auditoriumnumber<br />
                        <strong>Вместимость:</strong> @item.Auditoriumcapacity<br />
                        <strong>Предмет (код):</strong> @item.Auditoriumsubject
                    </p>
                    <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Редактировать</a>
                    <a asp-page="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Удалить</a>
                </div>
            </div>
        </div>
    }
</div>