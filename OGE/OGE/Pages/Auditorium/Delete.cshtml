@page
@model OGE.Pages.Auditorium.DeleteModel
@{
    ViewData["Title"] = "Удаление аудитории";
}

<h2>@ViewData["Title"]</h2>

<h3>Вы уверены, что хотите удалить эту аудиторию?</h3>
<div>
    <dl>
        <dt>Название</dt>
        <dd>@Model.Auditorium.Name</dd>
        <dt>Номер</dt>
        <dd>@Model.Auditorium.Auditoriumnumber</dd>
        <dt>Вместимость</dt>
        <dd>@Model.Auditorium.Auditoriumcapacity</dd>
        <dt>Предмет</dt>
        <dd>@Model.Auditorium.Auditoriumsubject</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Auditorium.Id" />
        <input type="submit" value="Удалить" class="btn btn-danger" />
        <a asp-page="Index" class="btn btn-secondary">Отмена</a>
    </form>
</div>